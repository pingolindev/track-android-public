<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    Disables all cloud backup and device-to-device transfer.

    Security rationale:
    - App stores sensitive location data and encryption keys
    - Backup could expose encrypted database to untrusted storage
    - Keys in Android Keystore are non-exportable anyway
-->
<data-extraction-rules>
    <!-- Disable cloud backup entirely -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>

    <!-- Disable device-to-device transfer -->
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
