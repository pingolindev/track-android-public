<?xml version="1.0" encoding="utf-8"?>
<!-- Track Premium / quota explainer. Shown when a free-tier user hits a
     count limit (places / circles / members / place alerts) or a
     premium-only feature (destinations). The
     title + benefit body are set per-resource in TrackPremiumBottomSheet.

     Informational only: describes what Premium unlocks but names no
     purchase channel and offers no upgrade link. Google Play prohibits
     directing users to an external purchase method for digital goods when
     not using Play Billing (matches the destinations "No purchase CTA"
     notice). The "Manage your plan at pingolin.com" line is plain text —
     not tappable, not a checkout deep-link. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvPremiumTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/premium_sheet_title_default"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:text="Save more places" />

        <TextView
            android:id="@+id/tvPremiumBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="The free plan includes 2 saved places. Premium removes the limit." />

        <TextView
            android:id="@+id/tvPremiumUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="You've used 2 of 2 on the free plan."
            tools:visibility="visible" />

        <!-- Plain, non-tappable management pointer. No checkout / IAP in the
             Play build. The libre build hides this line and shows the button
             below instead (TrackPremiumBottomSheet reads PlanManagement). -->
        <TextView
            android:id="@+id/tvPremiumManage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/premium_sheet_manage"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Libre only: opens the account portal's subscription page. Gone by
             default; the fragment shows it when PlanManagement allows it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPremiumManage"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/premium_sheet_manage_action"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPremiumDismiss"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/premium_sheet_dismiss" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
