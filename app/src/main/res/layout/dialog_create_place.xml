<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Fixed header with title and buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/places_create_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/places_create" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Address search — privacy-preserving local FTS over the
                 cities index (lazy-fetched ~7 MB tier 1, ~5 MB tier 2 on
                 demand). Hidden when invoked from a long-press on the
                 map (latLng already known) by setting layoutSearch.
                 visibility = GONE in the fragment. -->
            <LinearLayout
                android:id="@+id/layoutSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/places_search_hint"
                    app:startIconDrawable="@android:drawable/ic_menu_search"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Scope chip — pre-fills with the user's current
                     admin area on dialog open. Tap to change (opens
                     the city picker, dialog_city_scope_picker.xml). -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSearchScope"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/places_set_search_area"
                    app:chipIcon="@android:drawable/ic_menu_mylocation"
                    app:closeIconVisible="false" />

                <!-- Results — hidden until the user starts typing. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <!-- Empty-state hint shown when query has no matches. -->
                <TextView
                    android:id="@+id/tvSearchEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:text="@string/places_search_none_scoped"
                    android:visibility="gone" />

                <!-- Lightweight "loading…" indicator — shown only while
                     the city tier is downloading on first search. -->
                <TextView
                    android:id="@+id/tvSearchLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?colorPrimary"
                    android:textSize="13sp"
                    android:text="@string/places_search_setting_up"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Address display (shown when geocoded address is available) -->
            <LinearLayout
                android:id="@+id/layoutAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/places_address"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/places_label"
                app:helperText="@string/places_label_helper"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPlaceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="50" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Notes (optional free-form description). Stored
                 E2EE as encrypted_notes on the backend, like the
                 web app's place editor notes field. -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/places_notes"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPlaceNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minLines="2"
                    android:maxLength="500"
                    android:gravity="top|start" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- The alert area (radius) is set in the per-place bell dialog
                 (dialog_create_place_alert.xml / showPlaceAlertEditor): the radius is
                 the alert's trigger ring, so it's tuned where the alerts are. The
                 create/edit place dialogs don't set it — a new place keeps the
                 150 m default until an alert is configured. -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/places_icon"
                android:textStyle="bold" />

            <!-- Icon Grid - 3 rows x 6 columns = 18 icons -->
            <GridLayout
                android:id="@+id/gridIcons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="6"
                android:rowCount="3"
                android:alignmentMode="alignBounds">

                <!-- Row 1 -->
                <ImageButton
                    android:id="@+id/iconHome"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_home"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_home"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconWork"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_work"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_work"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconSchool"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_school"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_school"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconGym"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_gym"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gym"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconRestaurant"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_restaurant"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_restaurant"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconCoffee"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_coffee"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_coffee"
                    app:tint="?android:attr/textColorPrimary" />

                <!-- Row 2 -->
                <ImageButton
                    android:id="@+id/iconShopping"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_shopping"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_shopping"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconMedical"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_medical"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_medical"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconPark"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_park"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_park"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconBar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_bar"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_bar"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconGasStation"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_gas"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gas_station"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconAirport"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_airport"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_airport"
                    app:tint="?android:attr/textColorPrimary" />

                <!-- Row 3 -->
                <ImageButton
                    android:id="@+id/iconHotel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_hotel"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_hotel"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconParking"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_parking"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_parking"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconChurch"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_church"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_church"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconLibrary"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_library"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_library"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconStar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_star"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_star"
                    app:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/iconHeart"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:background="@drawable/icon_selector_background"
                    android:contentDescription="@string/places_icon_heart"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_heart"
                    app:tint="?android:attr/textColorPrimary" />

            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/places_color"
                android:textStyle="bold" />

            <!-- Color selector - horizontal row of color circles -->
            <LinearLayout
                android:id="@+id/layoutColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/colorRed"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_selector_background"
                    android:backgroundTint="#F44336"
                    android:contentDescription="@string/places_color_red" />

                <ImageButton
                    android:id="@+id/colorPink"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_selector_background"
                    android:backgroundTint="#E91E63"
                    android:contentDescription="@string/places_color_pink" />

                <ImageButton
                    android:id="@+id/colorPurple"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_selector_background"
                    android:backgroundTint="#9C27B0"
                    android:contentDescription="@string/places_color_purple" />

                <ImageButton
                    android:id="@+id/colorBlue"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_selector_background"
                    android:backgroundTint="#2196F3"
                    android:contentDescription="@string/places_color_blue" />

                <ImageButton
                    android:id="@+id/colorTeal"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_selector_background"
                    android:backgroundTint="#009688"
                    android:contentDescription="@string/places_color_teal" />

                <ImageButton
                    android:id="@+id/colorGreen"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_selector_background"
                    android:backgroundTint="#4CAF50"
                    android:contentDescription="@string/places_color_green" />

                <ImageButton
                    android:id="@+id/colorOrange"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/color_selector_background"
                    android:backgroundTint="#FF9800"
                    android:contentDescription="@string/places_color_orange" />

            </LinearLayout>

            <!-- Place Visibility — mirrors the web app's place editor.
                 Shows which circles see this place, lets the user add/remove
                 sharing inline. Hidden entirely when the user has no
                 circles (layoutPlaceVisibility.visibility = GONE).

                 Create-flow: adding a circle queues it locally and
                 PlacesFragment / MapFragment fire sharePlaceWithCircle
                 calls after the place is created.
                 Edit-flow: adding/removing calls share/unshare
                 immediately (same behavior as web). -->
            <LinearLayout
                android:id="@+id/layoutPlaceVisibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="12dp"
                    android:background="?android:attr/listDivider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/places_visibility_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/places_visibility_hint"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSharedCircles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingVertical="4dp" />

                <TextView
                    android:id="@+id/tvNoSharedCircles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/places_visibility_none"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="italic" />

                <LinearLayout
                    android:id="@+id/layoutAddSharedCircle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/spinnerShareCircle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareAddCircle"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/share" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
