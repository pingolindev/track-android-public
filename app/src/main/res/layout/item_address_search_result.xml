<?xml version="1.0" encoding="utf-8"?>
<!--
  One result row in the address-search dialog. Used for both
  "Cached areas" hits (from the local TileGeocoder forward search) and
  "Other locations" hits (from the global CityIndex). The same view
  type works for both because they show the same fields — the section
  header above the row is a separate item type in the adapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="4dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvResultPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="?android:attr/textColorPrimary"
        tools:text="Seattle" />

    <TextView
        android:id="@+id/tvResultSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="Washington, US · 737k people" />

</LinearLayout>
