<?xml version="1.0" encoding="utf-8"?>
<!-- One blocked address, with the action that takes it off the list. The button's content
     description names the address (BlockedPeopleAdapter): "Unblock" alone, read out in a list,
     does not say whom. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvBlockedEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnblock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/blocked_people_unblock"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>
