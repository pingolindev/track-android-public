<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Alert type chooser (create mode only) -->
        <TextView
            android:id="@+id/labelType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert type"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/rbBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔋 Battery"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbInactivity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏰ Inactivity" />
        </RadioGroup>

        <!-- Circle (create mode only) -->
        <TextView
            android:id="@+id/labelCircle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Circle"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <Spinner
            android:id="@+id/spinnerCircle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/spinner_background" />

        <!-- Read-only circle name shown in edit mode (the circle is immutable after creation). -->
        <TextView
            android:id="@+id/tvCircleValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Battery threshold section -->
        <LinearLayout
            android:id="@+id/layoutBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Battery threshold"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <SeekBar
                    android:id="@+id/seekbarThreshold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="45"
                    android:progress="15" />

                <TextView
                    android:id="@+id/tvThresholdValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="20%"
                    android:textAlignment="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Inactivity timeout section -->
        <LinearLayout
            android:id="@+id/layoutInactivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Inactivity timeout"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <SeekBar
                    android:id="@+id/seekbarTimeout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:min="0"
                    android:max="23"
                    android:progress="3" />

                <TextView
                    android:id="@+id/tvTimeoutValue"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="4 hours"
                    android:textAlignment="center" />
            </LinearLayout>

            <!-- A rule about others never goes off while they aren't sharing; hidden
                 for a rule about yourself (AlertsFragment.showEditor). -->
            <TextView
                android:id="@+id/tvInactivityNotWhileOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/inactivity_not_while_not_sharing"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <CheckBox
                android:id="@+id/checkboxSelfAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Alert me about my own inactivity" />

        </LinearLayout>

        <!-- Who the rule is about. Common to both types: a battery rule has
             exactly one target, which the person picks rather than the app
             silently taking whichever member happens to be first in the list. -->
        <TextView
            android:id="@+id/labelMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Who to watch"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:id="@+id/layoutMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <!-- Notifications -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Notifications"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <CheckBox
            android:id="@+id/checkboxPush"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Push notification"
            android:checked="true" />

    </LinearLayout>
</ScrollView>
