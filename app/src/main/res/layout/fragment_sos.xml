<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/sos_title" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_container"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sos_notify_green_on_surface"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="32dp">

                        <!-- The label is a phrase, which does not fit a disc,
                             so this is a full-width action of the same height
                             as the iOS button it is meant to match. -->
                        <!-- minHeight, not a fixed height: the label is a
                             sentence, and a fixed 96dp would clip it, dropping
                             the "not emergency services" half — the one part
                             that must not be lost. -->
                        <Button
                            android:id="@+id/btnSos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="96dp"
                            android:text="@string/sos_button"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/sos_notify_green"
                            app:cornerRadius="20dp" />

                        <!-- match_parent since the explanation below is a
                             sentence: inside a wrap_content column it would be
                             measured against the countdown digit and wrap into
                             a few characters per line. -->
                        <LinearLayout
                            android:id="@+id/countdownContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:textSize="72sp"
                                android:textStyle="bold"
                                android:textColor="@color/sos_notify_green_on_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sos_sending"
                                android:textColor="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/tvReachExplanation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center"
                                android:text="@string/sos_reach_explanation"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary" />

                            <Button
                                android:id="@+id/btnCancelCountdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="@string/sos_cancel"
                                style="@style/Widget.Material3.Button.OutlinedButton" />

                        </LinearLayout>

                        <!-- A raise that hasn't reached the circle, shown in place
                             of the button for as long as it lasts: waiting for a
                             connection (Cancel), or not sent (Try again, Close). -->
                        <LinearLayout
                            android:id="@+id/notSentContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvNotSent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:accessibilityLiveRegion="polite" />

                            <Button
                                android:id="@+id/btnNotSentTryAgain"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="@string/sos_not_sent_try_again"
                                android:backgroundTint="@color/sos_notify_green" />

                            <Button
                                android:id="@+id/btnNotSentLetGo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/sos_cancel"
                                style="@style/Widget.Material3.Button.OutlinedButton" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="@string/sos_tap_hint"
                            android:textColor="?android:attr/textColorSecondary" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/sos_active_alerts"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNoActiveAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="@string/sos_no_alerts"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvActiveAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false" />

                <!-- Alert Rules quick access -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSafetyRules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:cardBackgroundColor="@color/surface_container"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/safety_rules_title"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Set up battery and inactivity alerts"
                                android:textSize="13sp"
                                android:textColor="?android:attr/textColorSecondary" />

                        </LinearLayout>

                        <!--
                            A right chevron, because the card NAVIGATES: the
                            platform's "more" glyph draws as a circled
                            down-chevron and would read as "expands in place".
                        -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@string/safety_rules_title"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
