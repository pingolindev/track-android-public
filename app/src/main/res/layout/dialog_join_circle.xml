<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email address"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInviteCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Enter the email address of the person you want to invite."
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- Shown only when this layout is reused as the INVITE dialog, never when
         joining. Gone by default for that reason. Appended last on purpose: the
         invite path rewrites the helper text above via getChildAt(1), so a view
         inserted before it would silently retarget that. -->
    <TextView
        android:id="@+id/tvHistoryWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:text="@string/invite_history_warning"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

</LinearLayout>
