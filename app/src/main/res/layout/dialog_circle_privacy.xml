<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarAlwaysDrawVerticalTrack="true"
    android:fadeScrollbars="false">

<!--
    A PERMANENT scrollbar, not a fading one.

    This is the densest dialog in the app — members, five privacy switches,
    bubble mode, pause sharing, device visibility, ownership — and at the
    dialog's height the last visible row is cut mid-sentence ("only your primary
    device is…"). That reads as the end of the content unless something says
    otherwise. A scrollbar that is drawn before the first touch is the cheapest
    thing that says "there is more", and it costs nothing on a dialog that fits.
-->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Ownership claim banner.

         FIRST in the dialog on purpose. While this is visible the circle is on a clock
         that ends with somebody else owning it, which outranks every setting below it.
         The push that announces a claim can be swiped away and the deadline is two weeks
         out, so the circle's own screen has to keep saying it for as long as it is true.

         Shown to EVERY member, not just the owner: the server lets any active member read
         the claim precisely because a circle changing hands is not a private negotiation
         between two people. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOwnershipClaim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorErrorContainer"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorError"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvOwnershipClaimTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Someone has asked to take over this circle"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="?attr/colorOnErrorContainer" />

            <TextView
                android:id="@+id/tvOwnershipClaimBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnErrorContainer" />

            <TextView
                android:id="@+id/tvOwnershipClaimDeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnErrorContainer" />

            <!-- The owner's veto. The single control this whole feature exists to put on
                 screen: the push says "Open Pingolin to refuse", and this is what there
                 is to tap. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefuseOwnershipClaim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Refuse — keep my circle"
                android:visibility="gone"
                style="@style/Widget.Material3.Button" />

            <!-- Shown only to the person who asked. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWithdrawOwnershipClaim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Withdraw my request"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Members Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Members"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:textAllCaps="true"
        android:letterSpacing="0.1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <!-- Owners and admins: people Pingolin kept out of the circle. -->
    <TextView
        android:id="@+id/tvMembersKeptOut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="?android:attr/listDivider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:text="Privacy Settings"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:textAllCaps="true"
        android:letterSpacing="0.1" />

    <!-- Location consent.
         ABOVE the sharing switches, because it gates every one of them: with no
         live consent the server refuses this circle's locations outright.

         If you don't consent, you can't be in the circle: being a member IS
         sharing, so this row only says so. Pausing is below; stopping for good is
         leaving, by the circle's own Leave. It is hidden for anything but a live
         grant. -->
    <LinearLayout
        android:id="@+id/layoutLocationConsent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvConsentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            tools:text="You are sharing your location with this circle" />

        <TextView
            android:id="@+id/tvConsentDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="The settings below apply on top of this." />

    </LinearLayout>

    <!-- Your own location sharing here when it is off or paused, and what the circle sees.
         The consent row above says it when that row shows; this line says it for a
         membership without one. Set in CirclesFragment. -->
    <TextView
        android:id="@+id/tvOwnSharingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="@string/own_sharing_off" />

    <!-- How sharing stops for good, for every member and whatever the rows above say
         (GDPR Article 7(3)). -->
    <TextView
        android:id="@+id/tvSharingIsMembership"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:text="@string/sharing_is_membership" />

    <!-- Until THIS circle's settings have loaded, the controls below aren't shown and
         nothing on them can be saved. A read that failed says so, with Try again. -->
    <LinearLayout
        android:id="@+id/layoutPrivacyLoadState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvPrivacyLoadState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="@string/privacy_settings_loading" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrivacyRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="0dp"
            android:minWidth="0dp"
            android:visibility="gone"
            android:text="@string/privacy_settings_retry" />

    </LinearLayout>

    <!-- The settings this circle's server row holds, each written as you change it: shown only
         once they have loaded. -->
    <LinearLayout
        android:id="@+id/layoutPrivacyControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Share real-time location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_share_realtime_title"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_share_realtime_body"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchShareRealtime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- Share History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_share_history_title"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_share_history_body"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchShareHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- Low-battery alerts about me: the level only ever feeds them -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_low_battery_alerts_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvShareBatteryBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_low_battery_alerts_body"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchShareBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- Bubble Mode (approximate location) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bubble Mode"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvBubbleStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share approximate location"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchBubbleMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Bubble Radius (shown when bubble mode is on) -->
        <LinearLayout
            android:id="@+id/layoutBubbleRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bubble radius"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/tvBubbleRadiusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 mi"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?colorPrimary" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderBubbleRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="25"
                android:stepSize="1"
                android:value="1" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- Show All Devices -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show All Devices"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="When off, only your primary device is shown on the map"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchShowAllDevices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Allow Alerts On Me -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allow alerts on me"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Let members set alerts about you: arriving at or leaving a place, low battery, going quiet"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAllowAlertsOnMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <!-- Default Circle on Map -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default on map"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show this circle when opening the map"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDefaultCircle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <!-- Paused or not follows this circle's settings too: shown only once they have loaded. -->
    <LinearLayout
        android:id="@+id/layoutPauseControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Pause Sharing Status -->
        <LinearLayout
            android:id="@+id/layoutPauseStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPauseStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Paused until 5:00 PM"
                android:textColor="?attr/colorError" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resume"
                style="@style/Widget.Material3.Button.TextButton" />

        </LinearLayout>

        <!-- Pause Button (with duration selection) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPauseSharing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pause Sharing..."
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>


    <!-- Ask to take over (admins who are not the owner). Hidden by default and revealed
         from the fragment; the SERVER is the authority on whether it is allowed, so its
         refusal is surfaced rather than guessed at from a possibly stale local roster. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClaimOwnership"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ask to take over this circle"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <!-- Transfer Ownership Button (owners only) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTransferOwnership"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Transfer Ownership"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <!-- Manage Pending Invites Button (owners only) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManageInvites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Manage Pending Invites"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <!-- Key rotation is fully automatic — any active member's client rotates in the
         background when needed. No user action is ever required, so no UI is surfaced. -->

</LinearLayout>

</ScrollView>
