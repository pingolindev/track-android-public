<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_container"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCircleName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Circle Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <!-- Shown only when this device holds no key for the circle, so
                     the name renders as a placeholder. Without it the row is a
                     dead end: an oddly-named circle and nothing saying why or
                     who can fix it. -->
                <ImageButton
                    android:id="@+id/btnKeyUnavailableInfo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:visibility="gone"
                    android:src="@drawable/ic_info"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/circle_key_unavailable_info_cd" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCreatedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Created Jan 1, 2024"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOwner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Owner"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:clickable="false"
                    android:focusable="false"
                    app:chipMinHeight="20dp"
                    app:chipMinTouchTargetSize="0dp"
                    app:chipStartPadding="6dp"
                    app:chipEndPadding="6dp"
                    app:rippleColor="@android:color/transparent"
                    style="@style/Widget.Material3.Chip.Assist" />

            </LinearLayout>

            <!-- Owners and admins only, while a circle waits to be re-keyed after
                 somebody left or was removed: that person can still read what is
                 shared until it is. -->
            <TextView
                android:id="@+id/tvRekeyWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <!-- Changes waiting to go out from this phone, with their count; a
                 tap opens their list, each with Cancel. -->
            <TextView
                android:id="@+id/tvPendingChanges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnInvite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            android:contentDescription="Invite"
            android:visibility="gone"
            app:tint="?attr/colorPrimary" />

        <Button
            android:id="@+id/btnLeave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leave"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TextButton" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:visibility="gone"
            android:textColor="@color/error"
            style="@style/Widget.Material3.Button.TextButton" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
