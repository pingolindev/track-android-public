<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Circle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/place_alert_circle"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <Spinner
            android:id="@+id/spinnerCircle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/spinner_background" />

        <!-- Trigger (chips) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/place_alert_notify_when"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTrigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="false"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipArrives"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/place_alert_arrives"
                android:checkable="true"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLeaves"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/place_alert_leaves"
                android:checkable="true"
                android:checked="false" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Alert area — the geofence ring these enter/leave alerts fire on. There
             is ONE radius per place (radius_meters), shared by every alert on it,
             so saving here calls updatePlace under the hood. Tuned here (with the
             alerts) rather than in the place editor. The whole block is hidden for
             share RECIPIENTS (they don't own the place, so can't edit its single
             geofence radius). -->
        <LinearLayout
            android:id="@+id/layoutAlertArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/place_alert_area"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/tvBoundaryRadius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="200 m"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?colorPrimary" />

        </LinearLayout>

        <!-- 100 m floor (as in the web app's place editor): 50 m is below typical
             GPS accuracy, so its alerts would be unusable noise. Step 50 keeps the
             150 m default a valid slider step. -->
        <!--
            NO TICK MARKS, and an inactive track that reads as unfilled.

            100..2000 by 50 is 39 steps, and Material draws a dot per step: a
            thumb near the minimum above a track that is dotted and coloured end
            to end reads as "set to maximum". Ticks are for a handful of discrete
            choices; this is a continuous distance whose exact value is printed
            above the slider anyway. Naming both track colours makes the filled
            part mean something.
        -->
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderBoundaryRadius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:valueFrom="100"
            android:valueTo="2000"
            android:stepSize="50"
            android:value="200"
            app:tickVisible="false"
            app:trackColorActive="?attr/colorPrimary"
            app:trackColorInactive="?attr/colorSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/tvBoundaryRadiusMin"
                tools:text="100 m"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvBoundaryRadiusMax"
                tools:text="2 km"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/place_alert_area_note"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- Who to alert about -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/place_alert_about"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <RadioGroup
            android:id="@+id/radioWho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbAnyone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/place_alert_everyone"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbSpecific"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/place_alert_specific" />

        </RadioGroup>

        <!-- Advanced: per-member checkboxes (shown only when "Specific people" is selected) -->
        <LinearLayout
            android:id="@+id/layoutMemberCheckboxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="32dp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Stands in for the member list while it is empty. The members come
             from a Room flow behind a network refresh, so on a cold cache the
             list is genuinely empty for a moment — and an empty box reads as
             "this circle has nobody in it", which is a different answer. -->
        <TextView
            android:id="@+id/tvMembersEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            tools:text="Loading members…"
            tools:visibility="visible" />

        <!-- Schedule Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?android:attr/listDivider" />

        <CheckBox
            android:id="@+id/checkboxUseSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/place_alert_use_schedule"
            android:textStyle="bold"
            android:checked="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:text="@string/place_alert_schedule_hint"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Schedule Container (hidden by default) -->
        <LinearLayout
            android:id="@+id/scheduleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/place_alert_active_days"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMonday"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Mon"
                    android:checkable="true"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTuesday"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Tue"
                    android:checkable="true"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWednesday"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Wed"
                    android:checkable="true"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipThursday"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Thu"
                    android:checkable="true"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFriday"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Fri"
                    android:checkable="true"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSaturday"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Sat"
                    android:checkable="true"
                    android:checked="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSunday"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Sun"
                    android:checkable="true"
                    android:checked="false" />

            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/place_alert_time_window"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="08:00"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="@string/place_alert_time_to"
                    android:textColor="?android:attr/textColorSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEndTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="18:00"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

        </LinearLayout>

        <!-- Notification Preferences Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/place_alert_notifications"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkboxNotifyPush"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/place_alert_push"
            android:checked="true" />

        <CheckBox
            android:id="@+id/checkboxNotifyEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/place_alert_email"
            android:checked="false" />

        <!-- Save failure, shown in place instead of dismissing the dialog and
             discarding the edit. Carries the SERVER's own message so the user is
             told the actual reason rather than a generic failure. -->
        <TextView
            android:id="@+id/tvAlertError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textColor="@color/error"
            android:visibility="gone"
            tools:text="Chosen circle is not a valid home for this place"
            tools:visibility="visible" />

    </LinearLayout>
</ScrollView>
